{
  "defaultBranch": "main",
  "projectType": "python-mcp-service",
  "docs": {
    "index": "README.md",
    "agentGuide": "AGENTS.md",
    "tests": "tests/README.md",
    "projectMetadata": "pyproject.toml",
    "githubWorkflow": "AGENTS.md"
  },
  "qualityGate": {
    "setup": {
      "default": "uv sync --locked --group dev"
    },
    "run": {
      "server": "uv run odoo-intelligence-mcp"
    },
    "format": {
      "default": "uv run mcp-format",
      "check": "uv run ruff format --check ."
    },
    "test": {
      "unit": "uv run mcp-test-unit",
      "integration": "uv run mcp-test-integration",
      "ci": "uv run mcp-test-cov-ci",
      "quickUnit": "uv run mcp-test-ci",
      "liveStack": "uv run mcp-test-live",
      "staticAnalysis": "uv run ruff check .",
      "local": "uv run pytest -m 'not requires_docker and not requires_odoo' {test_paths}"
    },
    "coverage": {
      "default": "uv run mcp-test-cov",
      "ci": "uv run mcp-test-cov-ci",
      "liveStack": "uv run mcp-test-live-cov",
      "minimumPercent": 75
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": [
        "changed_files",
        "directory",
        "whole_project"
      ]
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "operations changes",
      "ownership boundaries change",
      "MCP tool contract changes",
      "Docker/Odoo runtime discovery changes",
      "pagination or response schema changes",
      "test or coverage command changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Dependency Graph",
    "Dependabot Updates"
  ],
  "prWorkflow": {
    "mergePolicy": "Hand reviewed, current-head green PRs to the merge train with gh-pr.py ready; active policy owns enrollment and routing.",
    "requiredStatusChecks": [
      "test"
    ],
    "requiredStatusChecksStrict": true,
    "codeScanningMergeProtection": {
      "ruleset": "Require code scanning results",
      "tool": "CodeQL",
      "alertsThreshold": "errors",
      "securityAlertsThreshold": "high_or_higher",
      "codeQualitySeverity": "errors"
    },
    "mergePath": "launchplane-merge-train"
  },
  "githubSettings": {
    "expected": {
      "deleteBranchOnMerge": true
    }
  },
  "relatedRepos": [
    "odoo-devkit",
    "odoo-shared-addons",
    "odoo-docker",
    "odoo-enterprise-docker",
    "odoo-tenant-cm",
    "odoo-tenant-opw"
  ],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true,
    "commands": [
      {
        "name": "mcp-clean",
        "command": "uv run mcp-clean",
        "when": "routine",
        "description": "Remove repo-local Python and test-generated artifacts such as pytest caches, coverage HTML, coverage data files, coverage.xml, __pycache__ directories, and pyc files."
      }
    ]
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "repo relationship changes",
      "cleanup policy changes",
      "ownership boundaries change",
      "MCP tool contract changes",
      "Docker/Odoo runtime discovery changes",
      "test or coverage command changes"
    ]
  }
}
