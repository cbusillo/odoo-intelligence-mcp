# Odoo Intelligence MCP Server Configuration

# Odoo project name/container prefix (required unless you set container overrides)
# Containers will be named: {prefix}-script-runner-1, {prefix}-web-1, etc.
# ODOO_PROJECT_NAME=odoo-opw

# Optional: point at a target project's .env
# ODOO_ENV_FILE=/path/to/project/.env

# Optional: workspace for platform env lookup and compose files (e.g. an odoo-devkit checkout)
# ODOO_PROJECT_DIR=/path/to/project

# Optional: <context>-<instance>; selects .platform/env/<context>.<instance>.env in that workspace
# ODOO_STACK_NAME=opw-local

# Optional: env precedence (default process; env_file lets the env file win)
# ODOO_ENV_PRIORITY=env_file

# Optional: compose files override (comma/colon separated)
# ODOO_COMPOSE_FILES=docker/config/base.yaml:docker/config/opw-local.yaml

# Optional: container overrides for non-standard setups
# ODOO_CONTAINER_NAME=odoo-web-1
# ODOO_SCRIPT_RUNNER_CONTAINER=odoo-script-runner-1
# ODOO_WEB_CONTAINER=odoo-web-1

# Odoo database name (default: odoo)
ODOO_DB_NAME=odoo

# Addon paths in the container (default: /odoo/addons,/odoo/odoo/addons,/opt/project/addons,/opt/extra_addons,/opt/enterprise)
ODOO_ADDONS_PATH=/opt/project/addons,/odoo/addons,/volumes/enterprise
